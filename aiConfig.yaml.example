bot_username: calarbot
answer_level: 980       # minimum dice roll (0-1000) to trigger random reply
call_weight: 200        # bonus roll when bot is @mentioned
reply_weight: 200       # bonus roll when replying to bot's message
system_prompt: "You are a witty participant in a Russian group chat."
context_size: 20        # number of recent messages to include as LLM context

openrouter_key: "sk-or-..."
nebius_key: "..."
nebius_url: "https://api.studio.nebius.ai/v1/"
nebius_vision_model: "..."
# Рисование живёт у отдельного провайдера: Nebius генерацию картинок убрал —
# в его каталоге не осталось ни одной такой модели. Подойдёт любой
# OpenAI-совместимый /images/generations; ключ нужен инференсный, не
# management — последний на инференс-эндпоинтах отвечает «User not found».
imagegen_url: "https://openrouter.ai/api/v1/"
imagegen_key: "sk-or-..."
imagegen_model: "google/gemini-2.5-flash-image"
persona_model: "openai/gpt-4o-mini"  # OpenRouter model for persona wrapping; leave empty to disable
sqlite_path: "/data/calarbot.db"
