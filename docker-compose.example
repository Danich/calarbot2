services:
  engine:
    build:
      context: .
      dockerfile: engine/Dockerfile
    image: calarbot2-engine:latest
    restart: unless-stopped
    command: ["./engine"]
    volumes:
      - /opt/calarbot/calarbot.yaml:/calarbot.yaml
      - /opt/calarbot/tokens/.tgtoken:/.tgtoken

  simpleReply:
    build:
      context: .
      dockerfile: modules/simpleReply/Dockerfile
    image: calarbot2-simplereply:latest
    restart: unless-stopped
    command: ["./simpleReply"]
    environment:
      - MODULE_PORT=8080
      - MODULE_ORDER=1000

  skazka:
    build:
      context: .
      dockerfile: modules/skazka/Dockerfile
    image: calarbot2-skazka:latest
    restart: unless-stopped
    command: ["./skazka"]
    environment:
      - MODULE_PORT=8080
      - MODULE_ORDER=100
    volumes:
      - /opt/calarbot/tokens/.tgtoken:/.tgtoken

  sberify-service:
    build: ./sberify-service
    image: sberify-service:latest
    environment:
      - PORT=5000
    restart: unless-stopped

  sber:
    build:
      context: .
      dockerfile: modules/sber/Dockerfile
    image: calarbot2-sber:latest
    restart: unless-stopped
    command: ["./sber"]
    environment:
      - MODULE_PORT=8080
      - MODULE_ORDER=500
      - SBERIFY_URL=http://sberify-service:5000/sberify
    depends_on:
      - sberify-service

  aiAnswer:
    build:
      context: .
      dockerfile: modules/aiAnswer/Dockerfile
    image: calarbot2-aianswer:latest
    restart: unless-stopped
    command: ["./aiAnswer"]
    environment:
      - MODULE_PORT=8080
      - MODULE_ORDER=100
    volumes:
      - /opt/calarbot/tokens/aiConfig.yaml:/aiConfig.yaml
      - /opt/calarbot/data:/data

  notify:
    build:
      context: .
      dockerfile: notify/Dockerfile
    image: calarbot2-notify:latest
    restart: unless-stopped
    command: ["./notify"]
    environment:
      - NOTIFY_PORT=8080
    ports:
      - "127.0.0.1:8091:8080"
    volumes:
      - /opt/calarbot/calarbot.yaml:/calarbot.yaml
      - /opt/calarbot/tokens/.tgtoken:/.tgtoken
